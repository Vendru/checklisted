<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the WAL sidecars carry uncheckpointed completions. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="checklisted.db" />
        <include domain="database" path="checklisted.db-wal" />
        <include domain="database" path="checklisted.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="checklisted.db" />
        <include domain="database" path="checklisted.db-wal" />
        <include domain="database" path="checklisted.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
