<?xml version="1.0" encoding="utf-8"?>
<!--
    A comb cell with the day's work struck through it.

    Both paths are stroke-only: a fillColor on the check would make VectorDrawable
    close the open polyline and fill the triangle in its crook, and a filled cell
    would swallow the check at launcher size.

    The whole mark sits inside the 72dp safe zone of the 108dp canvas, so no part of
    it is lost to a round, squircle or squircle-ish mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#1E1809"
        android:strokeWidth="6"
        android:strokeLineJoin="miter"
        android:strokeLineCap="butt"
        android:pathData="M54,24 L80,39 L80,69 L54,84 L28,69 L28,39 Z" />
    <path
        android:strokeColor="#1E1809"
        android:strokeWidth="8"
        android:strokeLineJoin="miter"
        android:strokeLineCap="butt"
        android:pathData="M41.5,55.2 L50.9,66 L66.5,43.2" />
</vector>
