root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Top-level design-token vals are PascalCase by Compose convention.
ktlint_standard_property-naming = disabled
# Multiline expressions as trailing lambda/argument values are idiomatic in Compose.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
# Modifier chains read as one call per line; the chain rule collapses them onto
# the closing paren of the previous call, which is much harder to scan.
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled

[*.{xml,yml,yaml,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
